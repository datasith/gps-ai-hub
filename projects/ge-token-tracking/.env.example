# Google Cloud Project ID where Gemini Enterprise is deployed
GCP_PROJECT_ID=your-gcp-project-id
PROJECT_ID=your-gcp-project-id

# Primary BigQuery dataset containing activity logs and token views
# Compatible with both `ge_token_analytics` (new standalone setup) and `ge_transformed` / `agent_analytics`
BQ_DATASET=ge_token_analytics
GE_TRANSFORMED_DATASET=ge_transformed
GE_VIEW=ge_logs
TOKEN_VIEW_DATASET=agent_analytics
TOKEN_VIEW_NAME=gemini_token_usage_by_user

# Default Gemini Enterprise instance filter on dashboard load (ALL or specific engine_id)
DEFAULT_GE_INSTANCE=ALL

# Cloud Run deployment region and service name
CLOUD_RUN_REGION=us-central1
DASHBOARD_SERVICE_NAME=ge-token-tracking-dashboard

# Local server bind address and port (default: 127.0.0.1:8080)
HOST=127.0.0.1
PORT=8080
